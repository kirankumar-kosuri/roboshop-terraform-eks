
pipeline {
    agent {
        node {
            label "Agent-1"
        }
    }

    environment {
        COURSE = "Jenkins"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    // Build stages
    stages {

        stage('Init') {
            steps {
                script {
                    withAWS(region: 'us-east-1', credentials: 'aws-creds') {
                        sh """
                            cd 20-bastion
                            terraform init
                        """
                    }
                }
            }
        }

        stage('Plan') {
            steps {
                script {
                    withAWS(region: 'us-east-1', credentials: 'aws-creds') {
                        sh """
                            cd 20-bastion
                            terraform plan
                        """
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    withAWS(region: 'us-east-1', credentials: 'aws-creds') {
                        sh """
                            cd 20-bastion
                            terraform apply --auto-approve
                        """
                    }
                }
            }
        }
    }

    // Post build stage
    post {
        always {
            echo "I will always say Hello again!"
            cleanWs()
        }

        success {
            echo "I will run if success"
        }

        failure {
            echo "I will run if failure"
        }

        // aborted {
        //     echo "Pipeline is Aborted please Check It"
        // }
    }
}
